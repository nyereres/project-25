# target to preprocess a source file
servo.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/main.dir/build.make CMakeFiles/main.dir/servo.cpp.i
.PHONY : servo.cpp.i

servo.s: servo.cpp.s
.PHONY : servo.s

# target to generate assembly for a file
servo.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/main.dir/build.make CMakeFiles/main.dir/servo.cpp.s
.PHONY : servo.cpp.s

